{
  "opencollection": "1.0.0",
  "info": {
    "name": "Spider Cloud Crawling Search API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search the Web",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.spider.cloud/search",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Run a web search query and optionally crawl the returned results."
        }
      ]
    }
  ],
  "bundled": true
}